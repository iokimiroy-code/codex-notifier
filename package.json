{
  "name": "codex-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start-dev.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "setup": "node scripts/install-notify.mjs install && node scripts/install-hooks.mjs install",
    "notify:install": "node scripts/install-notify.mjs install",
    "notify:uninstall": "node scripts/install-notify.mjs uninstall",
    "hooks:install": "node scripts/install-hooks.mjs install",
    "hooks:uninstall": "node scripts/install-hooks.mjs uninstall",
    "notify:agent": "node scripts/agent-notify.mjs",
    "test:bridge": "node --test tests/bridge.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.7",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0"
  }
}
